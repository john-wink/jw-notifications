parameters:
	ignoreErrors:
		-
			message: '#^Class App\\Models\\User not found\.$#'
			identifier: class.notFound
			count: 1
			path: config/jw-notifications.php

		-
			message: '#^Access to an undefined property JohnWink\\JwNotifications\\Filament\\Pages\\NotificationsPage\:\:\$form\.$#'
			identifier: property.notFound
			count: 1
			path: src/Filament/Pages/NotificationsPage.php

		-
			message: '#^Call to an undefined method Illuminate\\Foundation\\Auth\\User\:\:subscribedNotificationChannels\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Filament/Pages/NotificationsPage.php

		-
			message: '#^Trait JohnWink\\JwNotifications\\Traits\\CanSubscribeToChannels is used zero times and is not analysed\.$#'
			identifier: trait.unused
			count: 1
			path: src/Traits/CanSubscribeToChannels.php

		-
			message: '#^Trait JohnWink\\JwNotifications\\Traits\\HasCustomizedChannels is used zero times and is not analysed\.$#'
			identifier: trait.unused
			count: 1
			path: src/Traits/HasCustomizedChannels.php
